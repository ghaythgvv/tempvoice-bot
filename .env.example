# Copy this file to ".env" and fill in your own values.
# Never share your bot token with anyone or commit the real .env file.

# Bot > Reset Token, on your application's page in the Discord Developer Portal
DISCORD_TOKEN=

# The "Application ID" on the General Information page of the same portal
CLIENT_ID=

# Your server's ID (right-click your server icon in Discord with
# Developer Mode enabled in Settings > Advanced, then "Copy Server ID")
GUILD_ID=
